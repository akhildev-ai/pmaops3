{
  "name": "industrial-ai-train-dev",
  "timeout_seconds": 5400,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "train_predictive_maintenance_model",
      "notebook_task": {
        "notebook_path": "/Shared/industrial-ai-platform/notebooks/train_and_export",
