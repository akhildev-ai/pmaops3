          "experiment_path": "/Shared/industrial-ai-platform/experiments/dev",
          "bronze_output_uri": "s3://industrial-ai-dev-raw-123456789012/delta/bronze",
          "silver_output_uri": "s3://industrial-ai-dev-raw-123456789012/delta/silver",
          "gold_output_uri": "s3://industrial-ai-dev-raw-123456789012/delta/gold"
        }
      },
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
